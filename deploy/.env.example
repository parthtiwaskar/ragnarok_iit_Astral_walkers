# ======================  Ragnarisk deployment environment  ======================
# Copy to deploy/.env and fill in. Never commit the filled-in file.
# Everything marked REQUIRED must be set; the rest have safe defaults.

# ---- Secrets -------------------------------------------------------------------------
# REQUIRED. Protects the dashboard API. Anyone with it can start trials on your LLM key.
#   generate:  python -c "import secrets;print(secrets.token_urlsafe(32))"
APP_ACCESS_TOKEN=

# REQUIRED (at least one). Needed to run new trials; browsing saved cases works without.
DEEPSEEK_API_KEY=         # https://platform.deepseek.com   (cheapest; OpenAI-compatible, 128k context)
ANTHROPIC_API_KEY=        # https://console.anthropic.com  (recommended: strongest results)
GROQ_API_KEY=             # https://console.groq.com       (free tier is too small to finish a full trial)

# ---- Model selection -----------------------------------------------------------------
NINE_REALMS_PROVIDER=             # deepseek | anthropic | groq. Empty = first key set, in that order
DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_MODEL=claude-sonnet-5-5
GROQ_MODEL=openai/gpt-oss-120b

# ---- Network and safety --------------------------------------------------------------
NINE_REALMS_ENV=production        # hides internal error details from clients
HOST=0.0.0.0                      # the container always binds all interfaces; refuses to start without APP_ACCESS_TOKEN
PORT=8765
ALLOWED_ORIGINS=                  # extra browser origins allowed to POST, comma separated (same host is always allowed)
TRUST_PROXY=0                     # set 1 behind a reverse proxy so rate limits use X-Forwarded-For
ALLOW_INSECURE_PUBLIC=            # leave empty. 1 disables the "no public bind without a token" guard

# ---- Spending limits (trials cost money) -----------------------------------------------
MAX_TRIALS_PER_DAY=20             # across all users, per UTC day
TRIAL_COOLDOWN_SECONDS=30         # per client
MAX_LLM_CALLS=150                 # per trial
MAX_CASE_TOKENS=1000000           # per trial

# ---- Data and corpus -------------------------------------------------------------------
PACK_DIR=data/runemark            # build-time: where the Runemark pack is in the repo (docker build arg)
# The settings below are preset inside the container; only change them outside Docker.
DATA_DIR=/data                    # SQLite database + agent memory (mount a persistent volume here)
RUNEMARK_PACK=                    # path to a pack folder containing manifest.json (auto-detected if empty)
NINE_REALMS_DB=                   # overrides DATA_DIR/ragnarisk.sqlite
NINE_REALMS_MEMORY_DIR=           # overrides DATA_DIR/memory
IMPORT_RUNS_DIR=                  # saved runs/<case>/case.json imported on first start

# ---- Search --------------------------------------------------------------------------
NINE_REALMS_EMBEDDER=auto         # auto | fastembed | hash
NINE_REALMS_EMBED_MODEL=BAAI/bge-small-en-v1.5
FASTEMBED_CACHE=/models           # baked into the image

# ---- Logging -------------------------------------------------------------------------
LOG_LEVEL=info                    # info = one access-log line per request (no query strings); warning = quiet
