{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "nine-realms",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "nine_realms.server", "--host", "127.0.0.1", "--port", "8765", "--pack", "data/runemark"],
      "env": { "NINE_REALMS_EMBEDDER": "hash", "PYTHONUNBUFFERED": "1" },
      "port": 8765
    },
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "backend", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000,
      "url": "http://localhost:8000"
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--host", "localhost", "--port", "5173", "--strictPort"],
      "port": 5173
    }
  ]
}
