# ───────────── Trial of the Nine Realms — configuration ─────────────
# Copy to .env and fill in. Never commit .env.

# ---- LLM provider ----
LLM_PROVIDER=openai                 # openai | anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=                          # default model id for all agents (set to a current GPT or Claude model id)
LLM_TEMPERATURE=0.2

# Per-agent overrides (optional). Keep THOR and LOKI on the same model for fairness.
HEIMDALL_PROVIDER=
HEIMDALL_MODEL=
THOR_PROVIDER=
THOR_MODEL=
LOKI_PROVIDER=
LOKI_MODEL=
ODIN_PROVIDER=
ODIN_MODEL=                         # e.g. your strongest available model

# ---- Embeddings ----
EMBEDDINGS=fastembed                # fastembed | openai
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Paths ----
RUNEMARK_DIR=./data/runemark
LIVE_PACKS_DIR=./data/live_packs
DB_PATH=./data/index/runemark.sqlite
VECTORS_DIR=./data/index
MEMORY_DIR=./memory
RUNS_DIR=./runs

# ---- Trial limits (hard) ----
MAX_RUNS=3
MAX_ROUND2_EXCHANGES=1
MAX_CLAIMS_PER_SIDE=8
MIN_ATTACKS_PER_SIDE=1
MAX_ATTACKS_PER_SIDE=4
MAX_TOOL_CALLS_PER_TURN=12
MAX_TOOL_CALLS_PER_CASE=200
MAX_TOKENS_PER_TURN=60000
MAX_TOKENS_PER_CASE=600000
MAX_REPROMPTS=1
LLM_MAX_RETRIES=2
TOOL_MAX_RETRIES=1
TOOL_TIMEOUT_S=15
TURN_TIMEOUT_S=180
CASE_TIMEOUT_S=1200
MAX_REMAND_QUERIES=10

# ---- Case building ----
POOL_SIZE_R1=20
MAX_SCOPE_ROWS=6
HORIZON_MONTHS=3
VERIFY_MIN_TIER1=1                  # VERIFIED if >= this many non-retracted Tier 1 docs
VERIFY_MIN_TIER2_OUTLETS=2          # ...or >= this many distinct non-retracted Tier 2 outlets

# ---- Exposure model ----
EXPOSURE_METRIC=pct_value           # pct_value | pct_volume | abs_value
BASELINE_MONTHS=6
ANCHOR_TOL=0.3
MIN_PARAM_WIDTH=0.05
MAX_CONFIDENT_WIDTH_PP=15
TRADE_ROW_VISIBILITY=completed_month   # completed_month | month_start

# ---- Search ----
SEARCH_K_DEFAULT=8
RRF_K=60
W_BM25=1.0
W_DENSE=1.0
QUOTE_MATCH_MIN=90

# ---- Memory ----
MEMORY_TOP_K=5
MEMORY_MAX_LESSONS_PER_CASE=3

# ---- Ingestion ----
INGEST_FILE_TIMEOUT_S=20
WATCH_LIVE_PACKS=true

# ---- Server / UI ----
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# ---- Testing / chaos ----
LLM_FAULT_INJECT=                   # e.g. thor  → simulate Thor failing (chaos tests only)
